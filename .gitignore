# Rust
/target/
# Cargo.lock is intentionally committed (this workspace builds a cdylib
# PyO3 extension published as an application/binary artifact, not a library
# consumed by other Rust crates) -- pinning transitive versions matters for
# reproducible builds. Previously ignored here, which meant it was never
# actually tracked; fixed by removing this line and `git add`-ing it.
**/*.rs.bk
*.pdb

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

