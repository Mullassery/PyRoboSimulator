# PyRoboSimulator Backend Configuration
# Copy to .env for local development

# FastAPI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pyrobosim_dev
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=20
DATABASE_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MIN_SIZE=5
REDIS_POOL_MAX_SIZE=50

# Authentication
SECRET_KEY=change-me-in-production-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Simulation
MAX_AGENTS=1000000
MAX_SIMULATION_DURATION=3600
DEFAULT_TIMESTEP=0.016

# Monitoring
PROMETHEUS_PORT=8001
JAEGER_ENABLED=false
JAEGER_HOST=localhost
JAEGER_PORT=6831
